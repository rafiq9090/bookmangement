# Copy to .env.production. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
APP_HOST=books.example.com
MEDIA_HOST=media.books.example.com
ALLOWED_HOSTS=books.example.com
CSRF_TRUSTED_ORIGINS=https://books.example.com
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
POSTGRES_DB=book_marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
MEDIA_URL=https://media.books.example.com/media/
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Local autocomplete and manual pins work without any external geocoding.
GEOCODING_ENABLED=False
GEOCODING_USER_AGENT=

TRUST_PROXY_CLIENT_IP=True

# Optional browser notifications: provide all three values or leave all blank.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
